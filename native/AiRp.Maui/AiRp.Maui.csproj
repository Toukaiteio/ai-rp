<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AiRp.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>ai-rp</ApplicationTitle>
    <ApplicationId>asia.dys.rp</ApplicationId>
    <ApplicationUrl Condition="'$(ApplicationUrl)' == ''">https://rp.dys.asia/</ApplicationUrl>
    <AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == ''">apk</AndroidPackageFormat>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <RuntimeIdentifiers>win-x64;android-arm64;android-arm;android-x86;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <Target Name="GenerateBuildConfiguration" BeforeTargets="BeforeCompile">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)BuildConfiguration.g.cs"
      Lines="namespace AiRp.Maui; internal static class BuildConfiguration { public const string Url = &quot;$(ApplicationUrl)&quot;; }"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildConfiguration.g.cs" />
    </ItemGroup>
  </Target>
</Project>
